---
import BaseLayout from "../layouts/BaseLayout.astro";
import AreaGrid from "../components/AreaGrid.astro";
import { CONTACT } from "../config";
---

<BaseLayout sideBarActiveItemID="home" wide>
  <!-- HERO -->
  <section class="hw-container pt-14 pb-10 md:pt-20">
    <div class="grid md:grid-cols-[1.4fr_1fr] gap-10 items-center">
      <div>
        <span class="hw-badge">Undergraduate Researcher · Life Sciences &amp; Philosophy</span>
        <h1 class="hw-title hw-h1 mt-5">Hi, I'm Hayley Lim</h1>
        <p class="hw-lead mt-4 max-w-xl">
          An aspiring academic.
        </p>
        <div class="flex flex-wrap gap-3 mt-7">
          <a href="#areas" class="hw-btn hw-btn-primary">Explore my work</a>
          <a href="/cv" class="hw-btn hw-btn-secondary">View CV</a>
        </div>
      </div>
      <div class="flex justify-center md:justify-end">
        <div class="relative">
          <div class="absolute -inset-4 rounded-[40px] rotate-6" style="background: var(--accent-tint)"></div>
          <img src="/profile.jpg" alt="Hayley Lim" width="300" height="300"
            class="relative w-56 h-56 md:w-72 md:h-72 object-cover rounded-[32px]" />
        </div>
      </div>
    </div>
  </section>

  <!-- ABOUT -->
  <section class="hw-section" style="background: var(--card)">
    <div class="hw-container">
      <span class="hw-eyebrow">About me</span>
      <h2 class="hw-title hw-h2">Science and Philosophy, side by side</h2>
      <div class="mt-5 max-w-3xl text-[1.02rem] leading-relaxed space-y-4">
        <p>
          I am an Undergraduate Researcher majoring in Life Sciences with a minor in Philosophy. I'm inspired by the
          founding thinkers who were philosophers, scientists, mathematicians and theologians all at the same time. The
          concepts and theories they produced are a testament to the advantage of a multidisciplinary background.
        </p>
        <p>
          Within the sciences, I specialise in computational research; within philosophy, metaphysics. I deeply enjoy
          using classical logic to build models and craft philosophical arguments, and I hope to further knowledge and
          make better sense of the world we live in.
        </p>
      </div>
    </div>
  </section>

  <!-- AREAS -->
  <section id="areas" class="hw-section">
    <div class="hw-container">
      <span class="hw-eyebrow">My work</span>
      <h2 class="hw-title hw-h2">Areas of Work</h2>
      <p class="hw-lead mt-3 max-w-2xl">Research and projects across the lab, the computer and the seminar room.</p>
      <AreaGrid />
    </div>
  </section>

</BaseLayout>
