---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import { AREAS } from "../data/areas";
---

<BaseLayout title="Areas of Work" sideBarActiveItemID="projects">
  <div class="text-3xl w-full font-bold mb-5">Areas of Work</div>

  {AREAS.map((area) => (
    <>
      <HorizontalCard
        title={area.title}
        img={area.img}
        desc={area.summary}
        url={"/areas/" + area.slug}
        target="_self"
      />
      <div class="divider my-0" />
    </>
  ))}
</BaseLayout>
