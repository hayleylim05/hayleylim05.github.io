---
import BaseLayout from "../layouts/BaseLayout.astro";
import AreaGrid from "../components/AreaGrid.astro";
---

<BaseLayout title="Areas of Work" sideBarActiveItemID="projects" wide>
  <section class="hw-section">
    <div class="hw-container">
      <span class="hw-eyebrow">My work</span>
      <h1 class="hw-title hw-h1 mt-2">Areas of Work</h1>
      <p class="hw-lead mt-3 max-w-2xl">Choose an area to see the projects and research I've done.</p>
      <AreaGrid />
    </div>
  </section>
</BaseLayout>
