---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AreaIcon from "../../components/AreaIcon.astro";
import { AREAS } from "../../data/areas";
import { formatDesc } from "../../lib/formatDesc";

export function getStaticPaths() {
  return AREAS.map((area) => ({ params: { slug: area.slug }, props: { area } }));
}

const { area } = Astro.props;
---

<BaseLayout title={area.title} description={area.summary} sideBarActiveItemID="projects">
  <a href="/projects" class="text-sm font-semibold" style="color: var(--accent)">← All areas</a>

  <div class="flex items-center gap-4 mt-6">
    <AreaIcon name={area.icon} />
    <span class="hw-eyebrow">Area of work</span>
  </div>
  <h1 class="hw-title hw-h1 mt-3">{area.title}</h1>
  <p class="hw-lead mt-4">{area.intro}</p>

  <div class="flex flex-col gap-5 mt-10">
    {area.projects.map((p) => (
      <article class="hw-card">
        <div class="flex flex-wrap items-center gap-2">
          {p.period && <span class="hw-eyebrow">{p.period}</span>}
          {p.badge && <span class="hw-label">{p.badge}</span>}
        </div>
        <h2 class="hw-card-title text-xl">{p.title}</h2>
        {p.role && <div class="text-sm" style="color: var(--muted)">{p.role}</div>}

        <div class="hw-desc mt-1">
          {formatDesc(p.desc).map((b) =>
            b.type === "p" ? <p>{b.text}</p> : <ul>{b.items.map((i) => <li>{i}</li>)}</ul>
          )}
        </div>

        {p.skills && p.skills.length > 0 && (
          <div class="flex flex-wrap items-center gap-2">
            <span class="text-sm font-bold mr-1" style="color: var(--ink)">{area.skillsLabel ?? "Skills"}:</span>
            {p.skills.map((s) => <span class="hw-chip">{s}</span>)}
          </div>
        )}

        {p.links && p.links.length > 0 && (
          <div class="flex flex-wrap gap-2 mt-1">
            {p.links.map((l) => (
              <a href={l.url} target="_blank" rel="noopener" class="hw-btn hw-btn-secondary hw-btn-sm">{l.label} ↗</a>
            ))}
          </div>
        )}
      </article>
    ))}
  </div>
</BaseLayout>
