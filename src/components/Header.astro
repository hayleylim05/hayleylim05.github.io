---
import { CONTACT } from "../config";
const { active } = Astro.props;
const links = [
  { id: "home", label: "Home", href: "/" },
  { id: "projects", label: "Areas of Work", href: "/projects" },
  { id: "cv", label: "CV", href: "/cv" },
  { id: "contact", label: "Contact", href: CONTACT.email ? `mailto:${CONTACT.email}` : "/#contact" },
];
---

<header class="sticky top-0 z-30 bg-white/90 backdrop-blur border-b" style="border-color: var(--line)">
  <div class="hw-container flex items-center justify-between h-16">
    <a href="/" class="hw-title text-lg">Hayley Lim</a>

    <nav class="hidden md:flex items-center gap-1">
      {links.map((l) => (
        <a
          href={l.href}
          class="px-3 py-2 rounded-lg text-sm font-semibold transition-colors hover:bg-[var(--accent-tint)] hover:text-[var(--accent)]"
          style={active === l.id ? "color: var(--accent); background: var(--accent-tint)" : "color: var(--ink)"}
        >{l.label}</a>
      ))}
    </nav>

    <details class="md:hidden relative">
      <summary class="list-none cursor-pointer p-2 rounded-lg" aria-label="Menu">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
      </summary>
      <div class="absolute right-0 mt-2 w-48 bg-white border rounded-xl shadow-lg p-2 flex flex-col" style="border-color: var(--line)">
        {links.map((l) => (
          <a href={l.href} class="px-3 py-2 rounded-lg text-sm font-semibold" style={active === l.id ? "color: var(--accent)" : "color: var(--ink)"}>{l.label}</a>
        ))}
      </div>
    </details>
  </div>
</header>
