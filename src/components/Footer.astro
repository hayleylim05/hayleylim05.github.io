---
import { CONTACT } from "../config";
const today = new Date();
---

<footer class="mt-10 border-t" style="background: var(--card); border-color: var(--line)">
  <div class="hw-container py-10 flex flex-col md:flex-row gap-6 md:items-center md:justify-between">
    <div>
      <div class="hw-title text-base">Hayley Lim</div>
      <div class="text-sm mt-1" style="color: var(--muted)">Life Sciences &amp; Philosophy</div>
    </div>
    <div class="flex items-center gap-4 text-sm font-semibold">
      {CONTACT.email && <a href={`mailto:${CONTACT.email}`} class="hover:text-[var(--accent)]">Email</a>}
      {CONTACT.linkedin && <a href={CONTACT.linkedin} target="_blank" class="hover:text-[var(--accent)]">LinkedIn</a>}
      {CONTACT.github && <a href={CONTACT.github} target="_blank" class="hover:text-[var(--accent)]">GitHub</a>}
    </div>
  </div>
  <div class="hw-container pb-8 text-xs" style="color: var(--muted)">&copy; {today.getFullYear()} Hayley Lim</div>
</footer>
